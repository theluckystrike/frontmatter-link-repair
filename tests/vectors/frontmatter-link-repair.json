{
 "slug": "frontmatter-link-repair",
 "module": "frontmatter-link-repair/src/repair",
 "function": "repairText",
 "note": "Each case calls repairText with raw note text and the selected top-level keys. Expected output is exact. The notes are synthetic.",
 "cases": [
  {
   "name": "Scalar link gets double quotes",
   "args": [
    "---\nparent: [[Some note]]\n---\nBody\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nparent: \"[[Some note]]\"\n---\nBody\n",
    "matches": [
     {
      "line": 2,
      "key": "parent",
      "old": "parent: [[Some note]]",
      "new": "parent: \"[[Some note]]\""
     }
    ],
    "skips": []
   }
  },
  {
   "name": "Block list item with alias keeps its indentation",
   "args": [
    "---\nparents:\n  - [[A|Alias]]\n---\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nparents:\n  - \"[[A|Alias]]\"\n---\n",
    "matches": [
     {
      "line": 3,
      "key": "parents",
      "old": "  - [[A|Alias]]",
      "new": "  - \"[[A|Alias]]\""
     }
    ],
    "skips": []
   }
  },
  {
   "name": "Double quoted link stays the same",
   "args": [
    "---\nparent: \"[[A]]\"\n---\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nparent: \"[[A]]\"\n---\n",
    "matches": [],
    "skips": []
   }
  },
  {
   "name": "Single quoted link stays the same",
   "args": [
    "---\nparent: '[[A]]'\n---\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nparent: '[[A]]'\n---\n",
    "matches": [],
    "skips": []
   }
  },
  {
   "name": "Heading link gets quotes",
   "args": [
    "---\nup: [[A#Heading]]\n---\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nup: \"[[A#Heading]]\"\n---\n",
    "matches": [
     {
      "line": 2,
      "key": "up",
      "old": "up: [[A#Heading]]",
      "new": "up: \"[[A#Heading]]\""
     }
    ],
    "skips": []
   }
  },
  {
   "name": "Block reference link keeps its exact text",
   "args": [
    "---\nup: [[A#^block]]\n---\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nup: \"[[A#^block]]\"\n---\n",
    "matches": [
     {
      "line": 2,
      "key": "up",
      "old": "up: [[A#^block]]",
      "new": "up: \"[[A#^block]]\""
     }
    ],
    "skips": []
   }
  },
  {
   "name": "Body link stays the same",
   "args": [
    "---\ntitle: Note\n---\nSee [[A]] and\nparent: [[B]]\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\ntitle: Note\n---\nSee [[A]] and\nparent: [[B]]\n",
    "matches": [],
    "skips": []
   }
  },
  {
   "name": "Quote inside the link is ambiguous",
   "args": [
    "---\nparent: [[\"A\"]]\n---\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nparent: [[\"A\"]]\n---\n",
    "matches": [],
    "skips": [
     {
      "line": 2,
      "key": "parent",
      "reason": "Quote or backslash in the link text"
     }
    ]
   }
  },
  {
   "name": "Flow list with two items is ambiguous",
   "args": [
    "---\nrelated: [[[A]], [[B]]]\n---\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nrelated: [[[A]], [[B]]]\n---\n",
    "matches": [],
    "skips": [
     {
      "line": 2,
      "key": "related",
      "reason": "Flow list, comment or text next to the link"
     }
    ]
   }
  },
  {
   "name": "Two links on one line are ambiguous",
   "args": [
    "---\nrelated: [[A]], [[B]]\n---\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nrelated: [[A]], [[B]]\n---\n",
    "matches": [],
    "skips": [
     {
      "line": 2,
      "key": "related",
      "reason": "Flow list, comment or text next to the link"
     }
    ]
   }
  },
  {
   "name": "Comma in the link text is ambiguous",
   "args": [
    "---\nparent: [[A, B]]\n---\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nparent: [[A, B]]\n---\n",
    "matches": [],
    "skips": [
     {
      "line": 2,
      "key": "parent",
      "reason": "Comma in the link text, YAML reads a list with more than one item"
     }
    ]
   }
  },
  {
   "name": "Nested mapping is skipped",
   "args": [
    "---\nparent:\n  name: [[A]]\n---\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nparent:\n  name: [[A]]\n---\n",
    "matches": [],
    "skips": [
     {
      "line": 2,
      "key": "parent",
      "reason": "Nested mapping or nested list"
     }
    ]
   }
  },
  {
   "name": "Literal block scalar is skipped",
   "args": [
    "---\nparent: |\n  [[A]]\n---\n",
    [
     "parent",
     "parents",
     "up",
