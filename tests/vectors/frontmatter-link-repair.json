     }
    ]
   }
  },
  {
   "name": "Multiline plain scalar is skipped",
   "args": [
    "---\nparent: [[A]]\n  [[B]]\n---\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nparent: [[A]]\n  [[B]]\n---\n",
    "matches": [],
    "skips": [
     {
      "line": 2,
      "key": "parent",
      "reason": "Multiline scalar"
     }
    ]
   }
  },
  {
   "name": "No closing delimiter skips the file",
   "args": [
    "---\nparent: [[A]]\nBody text\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\nparent: [[A]]\nBody text\n",
    "matches": [],
    "skips": [
     {
      "line": 0,
      "key": "",
      "reason": "No closing frontmatter delimiter"
     }
    ]
   }
  },
  {
   "name": "Key that is not selected stays the same",
   "args": [
    "---\nsource: [[A]]\nparent: [[B]]\n---\n",
    [
     "parent"
    ]
   ],
   "expected": {
    "output": "---\nsource: [[A]]\nparent: \"[[B]]\"\n---\n",
    "matches": [
     {
      "line": 3,
      "key": "parent",
      "old": "parent: [[B]]",
      "new": "parent: \"[[B]]\""
     }
    ],
    "skips": []
   }
  },
  {
   "name": "CRLF line endings stay the same",
   "args": [
    "---\r\nparent: [[A]]\r\nparents:\r\n  - [[B]]\r\n---\r\nBody\r\n",
    [
     "parent",
     "parents",
     "up",
     "related"
    ]
   ],
   "expected": {
    "output": "---\r\nparent: \"[[A]]\"\r\nparents:\r\n  - \"[[B]]\"\r\n---\r\nBody\r\n",
    "matches": [
     {
      "line": 2,
      "key": "parent",
      "old": "parent: [[A]]",
      "new": "parent: \"[[A]]\""
     },
     {
      "line": 4,
      "key": "parents",
      "old": "  - [[B]]",
      "new": "  - \"[[B]]\""
     }
    ],
    "skips": []
   }
  },
  {
   "name": "Column 0 list items get quotes",
   "args": [
    "---\nparents:\n- [[A]]\n- \"[[B]]\"\n- plain text\n---\n",
    [
